# Recipe Costing / Inventory production additions only.
# Keep your existing DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME and other
# application settings. Do not replace the server's .env with this example.
# Run the backend with membership-backend as its working directory.
COSTING_DB_MODE=production
# Set this to exactly the existing production DB_NAME.
COSTING_DB_EXPECTED_NAME=REPLACE_WITH_EXISTING_DATABASE_NAME
# From SELECT @@server_uuid; on the existing production MySQL server.
COSTING_DB_EXPECTED_SERVER_UUID=REPLACE_WITH_PRODUCTION_MYSQL_UUID
